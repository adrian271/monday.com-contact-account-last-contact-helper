# Copy to .env.local and fill in your own values. .env.local is gitignored.
# Tip: run `npm run monday:test` to discover your board and column IDs.

# Monday.com API token (Profile → Administration → API → copy token)
MONDAY_API_TOKEN=your_monday_api_token_here

# Webhook signing secret (monday.com → Developers → your app → Signing Secret).
# When set, incoming webhooks must carry a valid signature or they're rejected (401).
# Strongly recommended before exposing the endpoint publicly.
MONDAY_SIGNING_SECRET=your_monday_signing_secret_here

# --- Boards ---
MONDAY_CONTACTS_BOARD_ID=your_contacts_board_id
MONDAY_ACCOUNTS_BOARD_ID=your_accounts_board_id

# --- Contacts board columns ---
MONDAY_OUTREACH_DATE_COLUMN_ID=your_contact_outreach_date_column_id
MONDAY_INTERVAL_COLUMN_ID=your_contact_interval_column_id
MONDAY_NEXT_FOLLOWUP_COLUMN_ID=your_contact_next_followup_column_id
MONDAY_CONTACT_ACCOUNT_LINK_COLUMN_ID=your_contact_to_account_link_column_id

# --- Accounts board columns ---
MONDAY_ACCOUNT_CONTACTS_LINK_COLUMN_ID=your_account_to_contacts_link_column_id
MONDAY_ACCOUNT_LATEST_OUTREACH_COLUMN_ID=your_account_latest_outreach_column_id
MONDAY_ACCOUNT_INTERVAL_COLUMN_ID=your_account_interval_column_id
MONDAY_ACCOUNT_NEXT_FOLLOWUP_COLUMN_ID=your_account_next_followup_column_id

# --- Guarded rollout (optional) ---
# Comma-separated account IDs the webhook is allowed to act on. Leave empty to
# allow ALL accounts. Set to specific IDs to limit a staged rollout.
MONDAY_ALLOWED_ACCOUNT_IDS=

# --- Manual test target for scripts/monday-test.mjs (optional) ---
MONDAY_TEST_CONTACT_ID=
MONDAY_TEST_ACCOUNT_ID=
